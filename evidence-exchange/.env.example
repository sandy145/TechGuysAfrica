# Copy to .env before running `npm run setup`.

# Prisma / SQLite. Swap to a postgresql:// URL and change the provider in
# prisma/schema.prisma to move to a managed database for a real deployment.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies, provider invitation links, and
# evidence-submission links. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-insecure-secret-change-me"

# Where uploaded evidence files are written. Everything under here is
# resident PHI plus pre-decisional survey material — encrypt at rest in any
# real deployment.
STORAGE_DIR="./storage"

# Public base URL, used to build invitation and notification links in email.
APP_URL="http://localhost:3000"

# Displayed in the page header and on generated notices. Set per deployment so
# one codebase can serve more than one state.
AGENCY_NAME="Residential Care Services"
AGENCY_PARENT="Department of Social and Health Services"
AGENCY_STATE="WA"
