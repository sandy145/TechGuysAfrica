# Copy to .env before running `npm run setup`.

# Prisma / SQLite. Swap to a postgresql:// URL and change the provider in
# prisma/schema.prisma to move off SQLite.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies and remote-signing links.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-insecure-secret-change-me"

# Separate secret used to derive the irreversible author hash on anonymous
# citation posts. Rotating this permanently detaches existing posts from their
# authors, which is a feature, not a bug.
ANON_SALT="dev-only-anon-salt-change-me"

# Where uploaded documents are written. Anything under here is resident PHI.
STORAGE_DIR="./storage"

# Public base URL, used to build remote signature links in emails.
APP_URL="http://localhost:3000"
